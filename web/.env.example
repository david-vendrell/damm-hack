# LineWise — Next.js dashboard environment.
# Copy this file to `web/.env` and fill in your own keys.
# `web/.env` is gitignored (see web/.gitignore) — never commit your secrets.

# Prisma SQLite connection string. Matches the path `start.sh` migrates.
# Only change this if you point Prisma at a different file.
DATABASE_URL="file:./dev.db"

# LineWise model sidecar (FastAPI, scripts/local_model_server.py).
# This is the PRIMARY model gateway. `start.sh` boots it for you on :8001
# via `npm run dev:full`. The /validar and /urgencias pages call it.
# If unreachable, the app silently degrades to a local heuristic.
LINEWISE_URL="http://localhost:8001"

# OpenAI key — REQUIRED for the natural-language Ask bar in /observabilidad.
# Get one at https://platform.openai.com/api-keys
# Without it, the rest of the dashboard still works; only the Ask bar 500s.
OPENAI_API_KEY="sk-..."

# Model used by the Ask bar (server-side). Defaults to gpt-4o-mini.
OPENAI_MODEL="gpt-4o-mini"

# Same model name surfaced as a label in the Ask bar UI (browser-side).
# Keep in sync with OPENAI_MODEL above so the badge matches reality.
NEXT_PUBLIC_OPENAI_MODEL="gpt-4o-mini"

# OPTIONAL — Hugging Face Space fallback (private Space: marcaguilar/linewise-demo).
# Currently unused by the running app; left in for the legacy HF path and for
# scripts/10_push_to_hf_space.py when redeploying the Space.
# HF_TOKEN="hf_..."

# OPTIONAL — override the Damm Excel directory used by `npm run ingest`.
# Defaults to `../Repte operacions` relative to the web/ folder.
# DATA_DIR="../Repte operacions"
